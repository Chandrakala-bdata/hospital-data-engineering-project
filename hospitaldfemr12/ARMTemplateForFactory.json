			"defaultValue": "hospitaldfemr12"
		},
		"AzureSqlDatabase1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabase1'"
		},
		"Hospitaldatastorage_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'Hospitaldatastorage'"
		},
		"AzureSqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "pocdataserver0123.database.windows.net"
		},
		"AzureSqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "Rcm-hsptl-db"
		},
		"AzureSqlDatabase1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "chandrakala"
		},
		"Hospitaldatastorage_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://hsptldataemr1.dfs.core.windows.net/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
